# automation-server/.env としてコピーし、実際のキーを入れてください(.envはgit管理外)。
# Google AI Studio (https://aistudio.google.com/apikey) で無料で取得できます。
GEMINI_API_KEY=

# 省略可。既定は gemini-2.0-flash。
# GEMINI_MODEL=gemini-2.0-flash

# 省略可。インサート素材フォルダのパス。既定は
# ~/Downloads/広告動画作成素材/広告素材
# EDITFLUX_BROLL_ROOT=/path/to/your/broll/root
